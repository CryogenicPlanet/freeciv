{
  "name": "freeciv-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Root Bun workspace for the active Freeciv Arena TypeScript packages",
  "workspaces": [
    "arena/*",
    "arena/tools/*"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.36.4",
    "@freeciv/oxlint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7"
  }
}
